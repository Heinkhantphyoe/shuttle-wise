{
  "name": "shuttlewise",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "firebase emulators:exec --only auth,firestore --project demo-shuttlewise \"vite --mode local-check-in\"",
    "build": "tsc --noEmit && vite build",
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test tests/*.test.mjs",
    "test:rules": "npx --yes firebase-tools emulators:exec --only firestore --project demo-shuttlewise \"node --disable-warning=ExperimentalWarning --experimental-strip-types --test tests/firestore.mjs\""
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  }
}
