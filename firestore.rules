rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'google.com'
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function routeValid(route) { return route in ['apu', 'lrt']; }
    function activityPath(uid) { return /databases/$(database)/documents/activity/$(uid); }
    function membershipPath(uid) { return /databases/$(database)/documents/rideMemberships/$(uid); }
    function ridePath(id) { return /databases/$(database)/documents/rides/$(id); }
    function historyPath(id) { return /databases/$(database)/documents/history/$(id); }
    function listingPath(id) { return /databases/$(database)/documents/rideListings/$(id); }
    function queueBefore(uid, route) {
      let activity = get(activityPath(uid)).data;
      return activity.kind == 'queue' && activity.route == route;
    }
    function membershipAfter(uid, id, route) {
      let membership = getAfter(membershipPath(uid)).data;
      return membership.rideId == id && membership.route == route;
    }
    function membershipBefore(uid, id) {
      let path = membershipPath(uid);
      return exists(path) ? get(path).data.rideId == id
        : get(activityPath(uid)).data.kind == 'ride' && get(activityPath(uid)).data.rideId == id;
    }
    function membershipRemoved(uid) {
      return !existsAfter(membershipPath(uid)) && (!existsAfter(activityPath(uid))
        || getAfter(activityPath(uid)).data.kind == 'queue');
    }

    match /admins/{uid} {
      allow get: if self(uid) && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    match /aiRateLimits/{uid} {
      function validRate() {
        return request.resource.data.keys().hasAll(['count', 'startedAt'])
          && request.resource.data.keys().hasOnly(['count', 'startedAt'])
          && request.resource.data.count is int && request.resource.data.count >= 1 && request.resource.data.count <= 6
          && request.resource.data.startedAt is timestamp;
      }
      allow get: if self(uid);
      allow create: if self(uid) && validRate() && request.resource.data.count == 1
        && request.resource.data.startedAt == request.time;
      allow update: if self(uid) && validRate() && (
        (request.time < resource.data.startedAt + duration.value(60, 's')
          && request.resource.data.startedAt == resource.data.startedAt && request.resource.data.count == resource.data.count + 1)
        || (request.time >= resource.data.startedAt + duration.value(60, 's')
          && request.resource.data.startedAt == request.time && request.resource.data.count == 1)
      );
    }

    function validRange(range) {
      return range == null || (range is list && range.size() == 2 && range[0] is int && range[1] is int
        && range[0] >= 1 && range[1] >= range[0] && range[1] <= 1000000);
    }
    function smallText(value, size) { return value is string && value.size() <= size; }
    function nullableTime(value) { return value == null || (value is string && value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')); }
    function validChange(change) {
      return change is map && change.keys().hasAll(['route', 'type', 'departures', 'start', 'end', 'delayMinutes', 'revisedTime', 'capacity', 'pickup'])
        && change.keys().hasOnly(['route', 'type', 'departures', 'start', 'end', 'delayMinutes', 'revisedTime', 'capacity', 'pickup'])
        && routeValid(change.route) && change.type in ['delay', 'cancel', 'suspend', 'replacement', 'pickup', 'capacity', 'info']
        && change.departures is list && change.departures.size() <= 60
        && nullableTime(change.start) && nullableTime(change.end) && nullableTime(change.revisedTime)
        && (change.delayMinutes == null || (change.delayMinutes is int && change.delayMinutes >= 1 && change.delayMinutes <= 720))
        && (change.capacity == null || (change.capacity is int && change.capacity >= 1 && change.capacity <= 200))
        && smallText(change.pickup, 200);
    }
    function revisionAdvanced() {
      let path = /databases/$(database)/documents/travelControl/notices;
      return getAfter(path).data.revision == (exists(path) ? get(path).data.revision : 0) + 1;
    }
    match /travelControl/{id} {
      allow get: if admin();
      allow create, update: if admin() && id == 'notices'
        && request.resource.data.keys().hasAll(['revision', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['revision', 'updatedAt'])
        && request.resource.data.revision is int && revisionAdvanced()
        && request.resource.data.updatedAt == request.time;
    }
    match /transportNotices/{id} {
      function validNotice() {
        let data = request.resource.data;
        return data.keys().hasAll(['title', 'summary', 'reason', 'sourceLabel', 'sourceExcerpt', 'sourceUrl', 'serviceDate',
          'visibleFrom', 'expiresAt', 'demo', 'changes', 'status', 'version', 'updatedAt'])
          && data.keys().hasOnly(['title', 'summary', 'reason', 'sourceLabel', 'sourceExcerpt', 'sourceUrl', 'serviceDate',
          'visibleFrom', 'expiresAt', 'demo', 'changes', 'status', 'version', 'updatedAt'])
          && smallText(data.title, 120) && data.title.size() > 0 && smallText(data.summary, 1000) && data.summary.size() > 0
          && smallText(data.reason, 300) && smallText(data.sourceLabel, 120) && data.sourceLabel.size() > 0
          && smallText(data.sourceExcerpt, 2000) && smallText(data.sourceUrl, 500)
          && (data.sourceUrl == '' || data.sourceUrl.matches('^https://[^ ]+$'))
          && data.serviceDate is string && data.serviceDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && data.visibleFrom is int && data.visibleFrom >= 0 && data.expiresAt is int
          && data.expiresAt > data.visibleFrom && data.expiresAt - data.visibleFrom <= 2764800000
          && data.demo is bool && data.changes is list && data.changes.size() >= 1 && data.changes.size() <= 2
          && validChange(data.changes[0]) && (data.changes.size() == 1 || (validChange(data.changes[1]) && data.changes[0].route != data.changes[1].route))
          && data.status in ['published', 'withdrawn', 'superseded'] && data.version is int
          && data.updatedAt == request.time && revisionAdvanced();
      }
      allow get, list: if admin() || (signedIn() && resource.data.status == 'published');
      allow create: if admin() && validNotice() && request.resource.data.status == 'published' && request.resource.data.version == 1;
      allow update: if admin() && validNotice() && request.resource.data.version == resource.data.version + 1;
    }
    match /travelSettings/{route} {
      function validSettings() {
        let data = request.resource.data;
        return data.keys().hasAll(['capacity', 'normalFare', 'rushFare', 'rushWindows', 'sourceLabel', 'demo', 'version', 'updatedAt'])
          && data.keys().hasOnly(['capacity', 'normalFare', 'rushFare', 'rushWindows', 'sourceLabel', 'demo', 'version', 'updatedAt'])
          && routeValid(route) && (data.capacity == null || (data.capacity is int && data.capacity >= 1 && data.capacity <= 200))
          && validRange(data.normalFare) && validRange(data.rushFare)
          && data.rushWindows is list && data.rushWindows.size() <= 14
          && smallText(data.sourceLabel, 120) && data.sourceLabel.size() > 0 && data.demo is bool
          && data.version is int && data.updatedAt == request.time;
      }
      allow get: if signedIn();
      allow create: if admin() && validSettings() && request.resource.data.version == 1;
      allow update: if admin() && validSettings() && request.resource.data.version == resource.data.version + 1;
    }
    match /transportNoticeAudit/{id} {
      allow read: if admin();
      allow create, update: if admin() && request.resource.data.keys().hasOnly(['adminUid', 'version', 'action', 'updatedAt'])
        && request.resource.data.adminUid == request.auth.uid && request.resource.data.version is int
        && request.resource.data.action in ['publish', 'withdraw', 'supersede'] && request.resource.data.updatedAt == request.time;
    }
    match /travelSettingsAudit/{route} {
      allow read: if admin();
      allow create, update: if admin() && routeValid(route)
        && request.resource.data.keys().hasOnly(['adminUid', 'version', 'updatedAt'])
        && request.resource.data.adminUid == request.auth.uid && request.resource.data.version is int
        && request.resource.data.updatedAt == request.time;
    }

    match /activity/{uid} {
      function newCheckIn() {
        let data = request.resource.data;
        let event = getAfter(historyPath(data.eventId)).data;
        return data.keys().hasOnly(['kind', 'route', 'joinedAt', 'eventId'])
          && data.kind == 'queue' && routeValid(data.route)
          && data.eventId is string && data.joinedAt == request.time
          && !exists(historyPath(data.eventId))
          && event.route == data.route && event.joinedAt == request.time;
      }
      function canLeaveRide() {
        let ride = getAfter(ridePath(resource.data.rideId)).data;
        return ride.status != 'open' || !(uid in ride.members);
      }
      allow get: if self(uid) || admin();
      allow list: if signedIn() && resource.data.kind == 'queue';
      allow create: if self(uid) && newCheckIn();
      allow update: if self(uid) && resource.data.kind == 'ride'
        && get(ridePath(resource.data.rideId)).data.status != 'open' && newCheckIn();
      allow delete: if self(uid) && (resource.data.kind == 'queue' || canLeaveRide());
    }

    match /rideMemberships/{uid} {
      function validMembership() {
        let data = request.resource.data;
        let ride = getAfter(ridePath(data.rideId)).data;
        return data.keys().hasOnly(['route', 'rideId']) && ride.status == 'open'
          && ride.route == data.route && uid in ride.members
          && getAfter(activityPath(uid)).data == get(activityPath(uid)).data
          && queueBefore(uid, data.route);
      }
      function canLeaveRide() {
        let ride = getAfter(ridePath(resource.data.rideId)).data;
        return ride.status != 'open' || !(uid in ride.members);
      }
      allow get: if self(uid);
      allow create: if self(uid) && validMembership();
      allow update: if self(uid) && get(ridePath(resource.data.rideId)).data.status != 'open' && validMembership();
      allow delete: if self(uid) && canLeaveRide();
    }

    match /history/{id} {
      function matchesCheckIn(uid) {
        let activity = getAfter(activityPath(uid)).data;
        return activity.kind == 'queue' && activity.eventId == id
          && activity.route == request.resource.data.route && activity.joinedAt == request.time;
      }
      allow read: if admin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['route', 'joinedAt'])
        && routeValid(request.resource.data.route)
        && request.resource.data.joinedAt == request.time
        && matchesCheckIn(request.auth.uid);
    }

    function matchesListing(listing, ride) {
      return listing.keys().hasOnly(['route', 'fare', 'status', 'count'])
        && listing.route == ride.route && listing.fare == ride.fare
        && listing.status == ride.status && listing.count == ride.members.size();
    }

    match /rideListings/{id} {
      function validListing() {
        let ride = getAfter(ridePath(id)).data;
        return ride.listed == true && matchesListing(request.resource.data, ride);
      }
      allow get: if signedIn() && (!exists(listingPath(id)) || resource.data.status == 'open');
      allow list: if signedIn() && resource.data.status == 'open';
      allow create, update: if signedIn() && validListing();
    }

    match /rides/{id} {
      function listingSynced() {
        let ride = request.resource.data;
        return !ride.get('listed', false) || matchesListing(getAfter(listingPath(id)).data, ride);
      }
      function validFare(fare) { return fare is int && fare >= 1 && fare <= 1000000; }
      function validName(name) { return name is string && name.size() > 0 && name.size() <= 40; }
      function createRide(uid) {
        let data = request.resource.data;
        return data.keys().hasOnly(['route', 'host', 'fare', 'members', 'status', 'listed'])
          && data.listed == true
          && routeValid(data.route) && data.host == uid && data.status == 'open'
          && validFare(data.fare) && data.members.keys().hasOnly([uid]) && validName(data.members[uid])
          && queueBefore(uid, data.route) && membershipAfter(uid, id, data.route);
      }
      function updateMembers(uid) {
        let before = resource.data;
        let after = request.resource.data;
        return after.diff(before).affectedKeys().hasOnly(['members'])
          && after.members.diff(before.members).affectedKeys().hasOnly([uid])
          && after.members.size() <= 4
          && (
            (before.get('listed', false) && !(uid in before.members) && uid in after.members && validName(after.members[uid])
              && queueBefore(uid, before.route) && membershipAfter(uid, id, before.route))
            || (uid != before.host && uid in before.members && !(uid in after.members)
              && membershipBefore(uid, id) && membershipRemoved(uid))
          );
      }
      function updateHost(uid) {
        let after = request.resource.data;
        let changes = after.diff(resource.data).affectedKeys();
        return uid == resource.data.host && membershipBefore(uid, id) && (
          (changes.hasOnly(['fare']) && validFare(after.fare))
          || (changes.hasOnly(['status']) && after.status in ['departed', 'cancelled']
            && membershipRemoved(uid))
        );
      }
      allow get: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && createRide(request.auth.uid) && listingSynced();
      allow update: if signedIn() && resource.data.status == 'open'
        && (updateMembers(request.auth.uid) || updateHost(request.auth.uid)) && listingSynced();
    }
  }
}
